
# Yayın URL'lerini imzalamak için gizli anahtar.
# Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TOFI_SECRET=degistir-beni

# Sağlayıcı CORS başlığı göndermiyorsa proxy'yi zorla.
# 1 olarak ayarla; aksi hâlde boş bırak (varsayılan: otomatik algılama).
NEXT_PUBLIC_FORCE_PROXY=

# ffmpeg ikili dosyasının tam yolu. İSTEĞE BAĞLI.
# Tarayıcının çözemediği sesi (MP2, AC-3, E-AC-3, DTS) AAC'ye çevirmek için
# kullanılır; video kopyalanır, yeniden kodlanmaz. Yalnızca ffmpeg PATH
# üzerinde değilse doldurun — örneğin winget kurulumu kısayol oluşturmaz.
# Boş bırakılırsa PATH'teki `ffmpeg` denenir; o da yoksa yayın sesi
# dönüştürülmeden olduğu gibi geçirilir.
# Örnek: C:\Users\ad\AppData\Local\Microsoft\WinGet\Packages\...\ffmpeg.exe
FFMPEG_PATH=
